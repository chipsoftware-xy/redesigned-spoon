# ===== FRONT END (set these in Vercel > Project > Settings > Environment Variables) =====
# The address of your hosted server, no slash at the end:
VITE_API_URL=https://your-server-name.onrender.com

# ===== SERVER (set these on Render/Railway > Environment) =====
# Only let your own website talk to the server (your Vercel address, no slash at the end):
CORS_ORIGIN=https://your-app.vercel.app
# Save accounts in a free Upstash Redis database (without these, accounts are lost on restart):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Keep the market open all the time (a "day" lasts 20 minutes) so visitors can always trade:
FORCE_OPEN=1
# Seconds between mood changes (default 30):
MOOD_COOLDOWN_SECONDS=30
# PORT is set by the host for you.
